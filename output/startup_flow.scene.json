    {
      "id": "e_decision_no",
      "type": "arrow_connector",
      "from": "wait_key:right",
      "to": "wait_key:top",
      "points": [[6.1, 7.6], [6.1, 6.75], [3.5, 6.75]],
      "label": "否（等待）",
      "style": {
        "line": "#F97316",
        "line_weight_pt": 1.3,
        "line_dash": "dash",
        "end_arrow": "triangle",
        "text_color": "#EA580C",
        "font_family": "Microsoft YaHei UI",
        "font_size_pt": 9
      }
    }
